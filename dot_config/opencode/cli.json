{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "keybinds": {
    "session.tab.next": "ctrl+down",
    "session.tab.previous": "ctrl+up"
  },
  "animations": true,
  "plugins": ["./herdr-opencode"]
}
