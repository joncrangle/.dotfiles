HISTORY_IGNORE="(ls|cd|pwd|zsh|exit|cd ..)"
HISTSIZE=10000
SAVEHIST=10000
LISTMAX=1000
COREPACK_ENABLE_AUTO_PIN=0

{{ if eq .chezmoi.os "darwin" -}}
# brew first so mise shims win (mise must activate last)
[[ -f /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
. "$HOME/.config/.local/share/../bin/env"
{{- end }}

if [[ -f "$HOME/.config/mise/gh_public.json" ]]; then
  export MISE_GITHUB_TOKEN=$(jq -r '.github_token' "$HOME/.config/mise/gh_public.json")
fi
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh --shims)"
fi

export EDITOR="$(which nvim 2>/dev/null || which vim 2>/dev/null || echo /usr/bin/vi)"
export VISUAL="$EDITOR"
export SUDO_EDITOR="$EDITOR"

if [[ "$SSH_AUTH_SOCK" == "$HOME/.local/share/wezterm/agent."* &&
  ! -S "$SSH_AUTH_SOCK" ]]; then
  unset SSH_AUTH_SOCK
fi

# Set completion paths before any plugin can initialize compinit.
typeset -U fpath
fpath=(
  "$ZDOTDIR/completions"
  {{ if eq .chezmoi.os "darwin" -}}
  "$HOMEBREW_DIR/share/zsh/site-functions"
  {{ end -}}
  $fpath
)
export ZSH_COMPDUMP="$ZDOTDIR/.zcompdump"

# Initialize vi-mode before other plugins add ZLE hooks, so its widget wrappers
# do not wrap and then re-enter add-zle-hook-widget's dispatcher.
function zvm_config() {
  ZVM_VI_SURROUND_BINDKEY=s-prefix
  ZVM_VI_HIGHLIGHT_FOREGROUND='#cdd6f4'
  ZVM_VI_HIGHLIGHT_BACKGROUND='#45475a'
  ZVM_VI_HIGHLIGHT_EXTRASTYLE=bold
  ZVM_INIT_MODE=sourcing
  ZVM_LINE_INIT_MODE=$ZVM_MODE_INSERT
  ZVM_INSERT_MODE_CURSOR=$ZVM_CURSOR_BLINKING_BEAM
  ZVM_NORMAL_MODE_CURSOR=$ZVM_CURSOR_BLINKING_BLOCK
  ZVM_VISUAL_MODE_CURSOR=$ZVM_CURSOR_BLINKING_BLOCK
  ZVM_VISUAL_LINE_MODE_CURSOR=$ZVM_CURSOR_BLINKING_BLOCK
}

{{ if eq .chezmoi.os "linux" -}}
source "/usr/share/zsh-antidote/antidote.zsh"
{{- else }}
source "$HOMEBREW_DIR/opt/antidote/share/antidote/antidote.zsh"
{{- end }}
antidote load

# Zephyr queues plugin compdefs; this call initializes completion once.
autoload -Uz compinit
if [[ -n $ZSH_COMPDUMP(#qN.m-1) ]]; then
  compinit -i -C -d "$ZSH_COMPDUMP"
else
  compinit -i -d "$ZSH_COMPDUMP" && touch "$ZSH_COMPDUMP"
fi

# Zsh completion
zstyle ':completion:*' group-name ''
zstyle ':completion:*' menu no
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:messages' format ' %F{yellow}%d%f'
zstyle ':completion:*:warnings' format ' %F{red}%d%f'

zstyle ':fzf-tab:*' single-group ''
zstyle ':fzf-tab:*' fzf-flags \
  '--height=~100%' \
  '--layout=reverse' \
  '--border=rounded' \
  '--padding=0' \
  '--info=hidden' \
  '--no-scrollbar' \
  '--prompt=  ' \
  '--color=pointer:#cba6f7'

# Completion navigation
zstyle ':fzf-tab:*' fzf-bindings \
  'ctrl-f:preview-page-down' \
  'ctrl-b:preview-page-up'

zstyle ':fzf-tab:*' switch-group '<' '>'
bindkey -M vicmd ":" undefined-key

eval "$(starship init zsh)"

function transient-line-finish() {
  [[ -n "$BUFFER" && "$CONTEXT" == start ]] || return 0

  # Local prompt variables shorten this finished line, then restore Starship's
  # definitions for the next prompt and for subsequent vi-mode redraws.
  local PROMPT="$(starship module character \
    --status="${STARSHIP_CMD_STATUS:-0}" --keymap="${KEYMAP:-viins}")"
  local RPROMPT='%F{8}%*%f '
  zle .reset-prompt
}
zle -N transient-line-finish
autoload -Uz add-zle-hook-widget
add-zle-hook-widget line-finish transient-line-finish

zvm_bindkey viins '^Y' autosuggest-accept

# Skim's generated bindings restore ZLE options and require a terminal.
if [[ -t 0 ]]; then
  if [[ ! -f "$ZDOTDIR/lib/sk_init.zsh" && -f "$ZDOTDIR/update_completions.zsh" ]]; then
    "$ZDOTDIR/update_completions.zsh"
  fi
  if [[ -f "$ZDOTDIR/lib/sk_init.zsh" ]]; then
    source "$ZDOTDIR/lib/sk_init.zsh"
  fi
fi

[[ -f "$ZDOTDIR/options.zsh" ]] && source "$ZDOTDIR/options.zsh"
[[ -f "$ZDOTDIR/aliases.zsh" ]] && source "$ZDOTDIR/aliases.zsh"
[[ -f "$ZDOTDIR/banner.zsh" ]] && source "$ZDOTDIR/banner.zsh"
